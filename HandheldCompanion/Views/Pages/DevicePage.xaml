<Page
    x:Class="HandheldCompanion.Views.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:HandheldCompanion.Behaviors"
    xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
    xmlns:controls="clr-namespace:HandheldCompanion.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:l="clr-namespace:HandheldCompanion.Localization"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:HandheldCompanion.Properties"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewmodels="clr-namespace:HandheldCompanion.ViewModels"
    Name="Device"
    Title="{l:Static resx:Resources.DevicePage_Device}"
    Margin="0,20,0,0"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodels:DevicePageViewModel}"
    d:DesignHeight="4300"
    d:DesignWidth="1000"
    KeepAlive="True"
    mc:Ignorable="d">

    <StackPanel>
        <TextBlock
            Margin="0,0,0,8"
            behaviors:TextBlockUpperCase.IsUpperCase="True"
            Style="{StaticResource CapitalAccentTextBlockStyle}"
            Text="{Binding Name, RelativeSource={RelativeSource AncestorType=Page}}" />

        <ikw:SimpleStackPanel Spacing="28">
            <!--  Power options  -->
            <ikw:SimpleStackPanel Name="PowerOptionsStack" Spacing="8">
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{l:Static resx:Resources.DevicePage_PowerOptions}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="Configurable TDP, undervolting and CPU clock methods" />
                </DockPanel>

                <ikw:SimpleStackPanel Spacing="3">
                    <!--  TDP control method  -->
                    <ui:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        Description="{l:Static resx:Resources.DevicePage_TDPControlMethodDesc}"
                        Header="{l:Static resx:Resources.DevicePage_TDPControlMethod}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xea86;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox SelectedIndex="{Binding ConfigurableTDPMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem>Default</ComboBoxItem>
                            <ComboBoxItem IsEnabled="{Binding HasWMIMethod, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">WMI</ComboBoxItem>
                        </ComboBox>
                    </ui:SettingsCard>

                    <!--  Advanced settings  -->
                    <ui:SettingsExpander
                        d:IsExpanded="True"
                        Description="{l:Static resx:Resources.SettingsPage_AdvancedSettingsDesc}"
                        Header="{l:Static resx:Resources.SettingsPage_AdvancedSettings}">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Glyph="&#xe785;" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:ToggleSwitch Name="Toggle_cTDP" IsOn="{Binding HasAdvancedSettings, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                        <ui:SettingsExpander.Items>
                            <!--  Configurable TDP down  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_TDPMinDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_TDPMin}"
                                IsEnabled="{Binding HasAdvancedSettings, UpdateSourceTrigger=PropertyChanged}">
                                <ui:NumberBox
                                    Name="NumberBox_TDPMin"
                                    MinWidth="20"
                                    Minimum="3"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="NumberBox_TDPMin_ValueChanged" />
                            </ui:SettingsCard>

                            <!--  Configurable TDP up  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_TDPMaxDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_TDPMax}"
                                IsEnabled="{Binding HasAdvancedSettings, UpdateSourceTrigger=PropertyChanged}">
                                <ui:NumberBox
                                    Name="NumberBox_TDPMax"
                                    MinWidth="20"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="NumberBox_TDPMax_ValueChanged" />
                            </ui:SettingsCard>

                            <!--  RyzenAdj (tctl-temp)  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_TctlTempDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_TctlTemp}"
                                IsEnabled="{Binding CanSetTctlTemperature, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsAMD, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:NumberBox
                                    Name="NumberBox_TctlLimit"
                                    MinWidth="20"
                                    Maximum="120"
                                    Minimum="30"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="NumberBox_TctlLimit_ValueChanged"
                                    Value="{Binding TctlLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </ui:SettingsCard>

                            <!--  RyzenAdj (apu-skin-temp)  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_SkinTempDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_SkinTemp}"
                                IsEnabled="{Binding CanSetSkinTemperature, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsAMD, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:NumberBox
                                    Name="NumberBox_SkinTemperatureLimit"
                                    MinWidth="20"
                                    Maximum="120"
                                    Minimum="30"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="NumberBox_SkinTemperatureLimit_ValueChanged"
                                    Value="{Binding SkinTemperatureLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </ui:SettingsCard>

                            <!--  RyzenAdj (set_coall)  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_AllCurveOptimiserDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_AllCurveOptimiser}"
                                IsEnabled="{Binding CanSetCoreCurve, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsAMD, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox
                                        Name="NumberBox_SetCoAll"
                                        MinWidth="20"
                                        Maximum="12"
                                        Minimum="-24"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="NumberBox_SetCoAll_ValueChanged" />

                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Padding="0,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        ToolTip="{l:Static resx:Resources.SettingsPage_AllCurveOptimiserTooltip}"
                                        ToolTipService.InitialShowDelay="200">
                                        <Grid>
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF138;" />
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF142;" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard>

                            <!--  RyzenAdj (set_cogfx)  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_GfxCurveOptimiserDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_GfxCurveOptimiser}"
                                IsEnabled="{Binding CanSetGPUCurve, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsAMD, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox
                                        Name="NumberBox_SetCoGfx"
                                        MinWidth="20"
                                        Maximum="12"
                                        Minimum="-24"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="NumberBox_SetCoGfx_ValueChanged" />

                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Padding="0,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        ToolTip="{l:Static resx:Resources.SettingsPage_GfxCurveOptimiserTooltip}"
                                        ToolTipService.InitialShowDelay="200">
                                        <Grid>
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF138;" />
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF142;" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard>

                            <!--  msr-cmd (core, cache)  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_MsrCPUUndervoltDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_MsrCPUUndervolt}"
                                IsEnabled="{Binding HasAdvancedSettings, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsIntel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox
                                        Name="NumberBox_SetMsrCore"
                                        MinWidth="20"
                                        Maximum="50"
                                        Minimum="-50"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="NumberBox_SetMsrCore_ValueChanged" />

                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Padding="0,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        ToolTip="{l:Static resx:Resources.SettingsPage_MsrCPUUndervoltTooltip}"
                                        ToolTipService.InitialShowDelay="200">
                                        <Grid>
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF138;" />
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF142;" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard>

                            <!--  msr-cmd (gpu)  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_MsrGPUUndervoltDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_MsrGPUUndervolt}"
                                IsEnabled="{Binding HasAdvancedSettings, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsIntel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox
                                        Name="NumberBox_SetMsrGpu"
                                        MinWidth="20"
                                        Maximum="50"
                                        Minimum="-50"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="NumberBox_SetMsrGpu_ValueChanged" />

                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Padding="0,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        ToolTip="{l:Static resx:Resources.SettingsPage_MsrGPUUndervoltTooltip}"
                                        ToolTipService.InitialShowDelay="200">
                                        <Grid>
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF138;" />
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF142;" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard>

                            <!--  msr-cmd (System agent)  -->
                            <ui:SettingsCard
                                Description="{l:Static resx:Resources.SettingsPage_MsrSocUndervoltDesc}"
                                Header="{l:Static resx:Resources.SettingsPage_MsrSocUndervolt}"
                                IsEnabled="{Binding HasAdvancedSettings, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsIntel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox
                                        Name="NumberBox_SetMsrSoc"
                                        MinWidth="20"
                                        Maximum="50"
                                        Minimum="-50"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="NumberBox_SetMsrSoc_ValueChanged" />

                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Padding="0,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        ToolTip="{l:Static resx:Resources.SettingsPage_MsrSocUndervoltTooltip}"
                                        ToolTipService.InitialShowDelay="200">
                                        <Grid>
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF138;" />
                                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF142;" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <!--  Enhanced Sleep  -->
                    <ui:SettingsCard
                        x:Name="EnhancedSleepCard"
                        Description="{l:Static resx:Resources.DevicePage_EnhancedSleepDesc}"
                        Header="{l:Static resx:Resources.DevicePage_EnhancedSleep}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE708;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:ToggleSwitch x:Name="Toggle_EnhancedSleep" Toggled="Toggle_EnhancedSleep_Toggled" />
                    </ui:SettingsCard>

                    <!--  Go Back To Sleep  -->
                    <ui:SettingsExpander
                        x:Name="GoBackToSleepExpander"
                        d:IsExpanded="True"
                        Description="{l:Static resx:Resources.DevicePage_GoBackToSleepDesc}"
                        Header="{l:Static resx:Resources.DevicePage_GoBackToSleep}">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE72E;" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:ToggleSwitch x:Name="Toggle_GoBackToSleep" Toggled="Toggle_GoBackToSleep_Toggled" />

                        <ui:SettingsExpander.Items>
                            <!--  Power button  -->
                            <ui:SettingsCard ContentAlignment="Left" IsEnabled="{Binding GoBackToSleep}">
                                <CheckBox
                                    x:Name="CB_GoBackToSleepOnPowerButton"
                                    Checked="CB_GoBackToSleepOnWakeReason_Changed"
                                    Content="{l:Static resx:Resources.DevicePage_GoBackToSleepOnPowerButtonDesc}"
                                    Unchecked="CB_GoBackToSleepOnWakeReason_Changed" />
                            </ui:SettingsCard>

                            <!--  Fingerprint reader  -->
                            <ui:SettingsCard ContentAlignment="Left" IsEnabled="{Binding GoBackToSleep}">
                                <CheckBox
                                    x:Name="CB_GoBackToSleepOnFingerprintReader"
                                    Checked="CB_GoBackToSleepOnWakeReason_Changed"
                                    Content="{l:Static resx:Resources.DevicePage_GoBackToSleepOnFingerprintReaderDesc}"
                                    Unchecked="CB_GoBackToSleepOnWakeReason_Changed" />
                            </ui:SettingsCard>

                            <!--  Joystick / controller  -->
                            <ui:SettingsCard ContentAlignment="Left" IsEnabled="{Binding GoBackToSleep}">
                                <CheckBox
                                    x:Name="CB_GoBackToSleepOnJoystick"
                                    Checked="CB_GoBackToSleepOnWakeReason_Changed"
                                    Content="{l:Static resx:Resources.DevicePage_GoBackToSleepOnJoystickDesc}"
                                    Unchecked="CB_GoBackToSleepOnWakeReason_Changed" />
                            </ui:SettingsCard>

                            <!--  Charger connected  -->
                            <ui:SettingsCard ContentAlignment="Left" IsEnabled="{Binding GoBackToSleep}">
                                <CheckBox
                                    x:Name="CB_GoBackToSleepOnChargerConnected"
                                    Checked="CB_GoBackToSleepOnWakeReason_Changed"
                                    Content="{l:Static resx:Resources.DevicePage_GoBackToSleepOnChargerConnectedDesc}"
                                    Unchecked="CB_GoBackToSleepOnWakeReason_Changed" />
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>
                </ikw:SimpleStackPanel>
            </ikw:SimpleStackPanel>

            <!--  Security options  -->
            <ikw:SimpleStackPanel Name="SecurityOptionsStack" Spacing="8">
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{l:Static resx:Resources.DevicePage_SecurityOptions}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="Core isolation and memory integrity" />
                </DockPanel>

                <!--  Core isolation  -->
                <ui:SettingsCard Description="{l:Static resx:Resources.DevicePage_CoreIsolationDesc}" Header="{l:Static resx:Resources.DevicePage_CoreIsolation}">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xE705;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ui:ToggleSwitch IsOn="{Binding MemoryIntegrity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingsCard>
            </ikw:SimpleStackPanel>

            <!--  Platform options  -->
            <ikw:SimpleStackPanel Name="PlatformOptionsStack" Spacing="8">
                <!--  OEM Frontend  -->
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{l:Static resx:Resources.DevicePage_PlatformOptions}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="OEM frontend and manufacturer application" />
                </DockPanel>

                <ui:SettingsCard
                    Description="{l:Static resx:Resources.DevicePage_ManufacturerApplicationDesc}"
                    Header="{l:Static resx:Resources.DevicePage_ManufacturerApplication}"
                    IsEnabled="{Binding HasManufacturerPlatform}">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xF156;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ToggleButton IsChecked="{Binding ManufacturerAppStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ManufacturerAppBusy, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                        <ToggleButton.Style>
                            <Style BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
                                <Setter Property="Content" Value="Restore" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ManufacturerAppStatus}" Value="True">
                                        <Setter Property="Content" Value="Disable" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </ui:SettingsCard>

                <ui:ProgressBar IsIndeterminate="{Binding ManufacturerAppBusy, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ManufacturerAppBusy, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False}" />
            </ikw:SimpleStackPanel>

            <!--  Display options  -->
            <ikw:SimpleStackPanel Name="DisplayOptionsStack" Spacing="8">
                <!--  Docked display behavior  -->
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{l:Static resx:Resources.DevicePage_DisplayOptions}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="Docked display and external monitor behaviour" />
                </DockPanel>

                <ui:SettingsCard Description="{l:Static resx:Resources.DevicePage_DockedDisplayBehaviorDesc}" Header="{l:Static resx:Resources.DevicePage_DockedDisplayBehavior}">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xE7F4;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ComboBox Name="cB_DockedDisplayBehavior" SelectionChanged="cB_DockedDisplayBehavior_SelectionChanged">
                        <ComboBoxItem Content="{l:Static resx:Resources.DevicePage_DockedDisplayBehavior_DoNothing}" />
                        <ComboBoxItem Content="{l:Static resx:Resources.DevicePage_DockedDisplayBehavior_SwitchToExternal}" />
                        <ComboBoxItem Content="{l:Static resx:Resources.DevicePage_DockedDisplayBehavior_SwitchToExternalWhenCharging}" />
                    </ComboBox>
                </ui:SettingsCard>
            </ikw:SimpleStackPanel>

            <!--  Battery options  -->
            <ikw:SimpleStackPanel
                Name="BatteryChargeStack"
                d:Visibility="Visible"
                Spacing="8"
                Visibility="{Binding BatteryBypassVisibility, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">

                <!--  Battery Charge  -->
                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{l:Static resx:Resources.DevicePage_BatteryOptions}" />
                <ui:SettingsExpander
                    Name="BatteryChargeLimitToggle"
                    d:IsExpanded="True"
                    Description="{l:Static resx:Resources.DevicePage_BatteryChargeLimit_Desc}"
                    Header="{l:Static resx:Resources.DevicePage_BatteryChargeLimit}"
                    IsEnabled="{Binding BatteryChargeLimitCapacity, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon Glyph="&#xebb2;" />
                    </ui:SettingsExpander.HeaderIcon>

                    <ui:ToggleSwitch Name="Toggle_BatteryChargeLimit" Toggled="Toggle_BatteryChargeLimit_Toggled" />

                    <ui:SettingsExpander.Items>
                        <!--  Battery charge limit  -->
                        <ui:SettingsCard
                            Name="BatteryChargeLimitPercent"
                            Description="{l:Static resx:Resources.DevicePage_BatteryChargeLimitPercent_Desc}"
                            Header="{l:Static resx:Resources.DevicePage_BatteryChargeLimitPercent}"
                            IsEnabled="{Binding BatteryChargeLimit, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                            <DockPanel>
                                <TextBox
                                    Height="31"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Text="{Binding BatteryChargeLimitPercent, StringFormat={}{0:N0}%, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Slider
                                    x:Name="Slider_BatteryChargeLimitPercent"
                                    Width="200"
                                    Margin="6,0,0,0"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="{Binding BatteryBypassStep, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    Maximum="{Binding BatteryBypassMax, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="{Binding BatteryBypassMin, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    SmallChange="{Binding BatteryBypassStep, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="{Binding BatteryBypassStep, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    TickPlacement="BottomRight"
                                    ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    ValueChanged="Slider_BatteryChargeLimitPercent_OnValueChanged"
                                    Value="{Binding BatteryChargeLimitPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </ui:SettingsCard>

                        <!--  Battery bypass (ONEXPLAYER X1)  -->
                        <ui:SettingsCard
                            Name="BatteryBypassCharging"
                            d:Visibility="Visible"
                            Description="{l:Static resx:Resources.DevicePage_BatteryBypassCharging_Desc}"
                            Header="{l:Static resx:Resources.DevicePage_BatteryBypassCharging}"
                            IsEnabled="{Binding BatteryChargeLimit, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding BatteryBypassModeVisibility, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox
                                Name="CB_BatteryBypassCharging"
                                ItemsSource="{Binding DeviceBatteryBypassPresets}"
                                SelectionChanged="CB_BatteryBypassCharging_OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <ItemContainerTemplate>
                                        <WrapPanel>
                                            <TextBlock
                                                Height="25"
                                                Margin="10,6,0,0"
                                                Text="{Binding DisplayName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </WrapPanel>
                                    </ItemContainerTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
            </ikw:SimpleStackPanel>

            <!--  Dynamic lighting settings  -->
            <ikw:SimpleStackPanel
                Name="DynamicLightingPanel"
                d:Visibility="Visible"
                Spacing="8"
                Visibility="{Binding IsDynamicLightingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{l:Static resx:Resources.DevicePage_DynamicLightTitle}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="RGB effects, brightness and colour selection" />
                </DockPanel>

                <!--  Use Dynamic lighting  -->
                <ui:SettingsCard Header="{l:Static resx:Resources.DevicePage_DynamicLightDesc}">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xE781;" />
                    </ui:SettingsCard.HeaderIcon>
                    <ui:ToggleSwitch Name="UseDynamicLightingToggle" Toggled="UseDynamicLightingToggle_Toggled" />
                </ui:SettingsCard>

                <!--  TODO: Remove this stackpanel and move IsEnabled to the SettingsCard/SettingsExpander by storing the Toggle on Viewmodel  -->
                <ikw:SimpleStackPanel
                    Name="LEDPanel"
                    IsEnabled="{Binding ElementName=UseDynamicLightingToggle, Path=IsOn}"
                    Spacing="8">
                    <!--  Static LED Brightness  -->
                    <ui:SettingsCard
                        Name="LEDBrightness"
                        Description="{l:Static resx:Resources.DevicePage_DynamicLighting_BrightnessDesc}"
                        Header="{l:Static resx:Resources.DevicePage_DynamicLighting_Brightness}"
                        Visibility="{Binding IsLedBrightnessVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE706;" />
                        </ui:SettingsCard.HeaderIcon>
                        <DockPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBox
                                Height="31"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                IsReadOnly="True"
                                Text="{Binding Value, StringFormat={}{0:N0}%, Source={x:Reference SliderLEDBrightness}, Mode=OneWay}" />
                            <Slider
                                x:Name="SliderLEDBrightness"
                                Width="200"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                IsSnapToTickEnabled="True"
                                LargeChange="10"
                                Maximum="100"
                                Minimum="0"
                                SmallChange="5"
                                TickFrequency="5"
                                TickPlacement="BottomRight"
                                ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                ValueChanged="SliderLEDBrightness_ValueChanged"
                                Value="100" />
                        </DockPanel>
                    </ui:SettingsCard>

                    <!--  Dynamic lighting effects  -->
                    <ui:SettingsExpander
                        Name="DynamicLightingEffects"
                        d:IsExpanded="True"
                        Description="{l:Static resx:Resources.DevicePage_DynamicLightingDesc}"
                        Header="{l:Static resx:Resources.DevicePage_DynamicLighting}">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Glyph="&#xF4A5;" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ComboBox
                            Name="LEDSettingsLevel"
                            Width="220"
                            SelectionChanged="LEDSettingsLevel_SelectionChanged">

                            <ComboBoxItem
                                Name="LEDSolidColor"
                                Content="{l:Static resx:Resources.DevicePage_DynamicLighting_SolidColor}"
                                IsEnabled="{Binding IsSolidColorSupported}"
                                Tag="1"
                                Visibility="{Binding IsSolidColorSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBoxItem
                                Name="LEDBreathing"
                                Content="{l:Static resx:Resources.DevicePage_DynamicLighting_Breathing}"
                                IsEnabled="{Binding IsBreathingSupported}"
                                Tag="2"
                                Visibility="{Binding IsBreathingSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBoxItem
                                Name="LEDRainbow"
                                Content="{l:Static resx:Resources.DevicePage_DynamicLighting_Rainbow}"
                                IsEnabled="{Binding IsRainbowSupported}"
                                Tag="4"
                                Visibility="{Binding IsRainbowSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBoxItem
                                Name="LEDWave"
                                Content="{l:Static resx:Resources.DevicePage_DynamicLighting_Wave}"
                                IsEnabled="{Binding IsWaveSupported}"
                                Tag="8"
                                Visibility="{Binding IsWaveSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBoxItem
                                Name="LEDWheel"
                                Content="{l:Static resx:Resources.DevicePage_DynamicLighting_Wheel}"
                                IsEnabled="{Binding IsWheelSupported}"
                                Tag="16"
                                Visibility="{Binding IsWheelSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBoxItem
                                Name="LEDGradient"
                                Content="{l:Static resx:Resources.DevicePage_DynamicLighting_Gradient}"
                                IsEnabled="{Binding IsGradientSupported}"
                                Tag="32"
                                Visibility="{Binding IsGradientSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBoxItem
                                Name="LEDAmbilight"
                                Content="{l:Static resx:Resources.DevicePage_DynamicLighting_Ambilight}"
                                IsEnabled="{Binding IsAmbilightSupported}"
                                Tag="64"
                                Visibility="{Binding IsAmbilightSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBoxItem
                                Name="LEDPreset"
                                Content="{l:Static resx:Resources.DevicePage_DynamicLighting_Presets}"
                                IsEnabled="{Binding IsPresetSupported}"
                                Tag="128"
                                Visibility="{Binding IsPresetSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </ComboBox>
                        <ui:SettingsExpander.Items>
                            <!--  Effect speed  -->
                            <ui:SettingsCard
                                d:Visibility="Visible"
                                Header="{l:Static resx:Resources.DevicePage_DynamicLighting_EffectSpeed}"
                                Visibility="{Binding Source={x:Reference LEDSettingsLevel}, Path=SelectedIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1|2|3|4|5|6}">
                                <DockPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                        Text="{Binding Value, StringFormat={}{0:N0}%, Source={x:Reference SliderLEDSpeed}, Mode=OneWay}" />
                                    <Slider
                                        x:Name="SliderLEDSpeed"
                                        Width="200"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="10"
                                        Maximum="100"
                                        Minimum="10"
                                        SmallChange="5"
                                        TickFrequency="5"
                                        TickPlacement="BottomRight"
                                        ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                        ValueChanged="SliderLEDSpeed_ValueChanged"
                                        Value="100" />
                                </DockPanel>
                            </ui:SettingsCard>

                            <!--  Direction  -->
                            <!--  Visibility="{Binding Source={x:Reference LEDSettingsLevel}, Path=SelectedIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2|3|4|5}"  -->
                            <ui:SettingsCard
                                d:Visibility="Visible"
                                Header="{l:Static resx:Resources.DevicePage_DynamicLighting_EffectDirection}"
                                Visibility="Collapsed">
                                <DockPanel>
                                    <ComboBox
                                        Name="LEDDirection"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        SelectedIndex="0"
                                        SelectionChanged="LEDDirection_SelectionChanged" />
                                </DockPanel>
                            </ui:SettingsCard>

                            <!--  Main color  -->
                            <!--  Match my Windows accent color  -->
                            <ui:SettingsCard
                                d:Visibility="Visible"
                                Header="{l:Static resx:Resources.DevicePage_DynamicLighting_MatchAccentColor}"
                                Visibility="{Binding Source={x:Reference LEDSettingsLevel}, Path=SelectedIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0|1|3|5}">
                                <ui:ToggleSwitch Name="MatchAccentColor" Toggled="MatchAccentColor_Toggled" />
                            </ui:SettingsCard>

                            <!--  Main color picker  -->
                            <ui:SettingsCard
                                d:Visibility="Visible"
                                Header="{l:Static resx:Resources.DevicePage_DynamicLighting_MainColorSelection}"
                                Visibility="{Binding Source={x:Reference LEDSettingsLevel}, Path=SelectedIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0|1|3|5}">
                                <colorpicker:PortableColorPicker
                                    Name="MainColorPicker"
                                    Width="32"
                                    Height="31"
                                    ColorChanged="MainColorPicker_ColorChanged"
                                    IsEnabled="{Binding IsColorPickerEnabled}"
                                    Style="{StaticResource DefaultColorPickerStyle}" />
                            </ui:SettingsCard>

                            <!--  Use second color  -->
                            <ui:SettingsCard
                                Name="SecondColorToggleCard"
                                d:Visibility="Visible"
                                Header="{l:Static resx:Resources.DevicePage_UseSecondColor}"
                                IsEnabled="{Binding IsSecondColorSupported}"
                                Visibility="{Binding Source={x:Reference LEDSettingsLevel}, Path=SelectedIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0|1}">
                                <ui:ToggleSwitch Name="Toggle_UseSecondColor" Toggled="Toggle_UseSecondColor_Toggled" />
                            </ui:SettingsCard>

                            <!--  Second color  -->
                            <ui:SettingsCard
                                Name="SecondColorPickerCard"
                                d:Visibility="Visible"
                                Header="{l:Static resx:Resources.DevicePage_DynamicLighting_SecondColorSelection}"
                                IsEnabled="{Binding Source={x:Reference Toggle_UseSecondColor}, Path=IsOn}"
                                Visibility="{Binding Source={x:Reference LEDSettingsLevel}, Path=SelectedIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0|1}">
                                <colorpicker:PortableColorPicker
                                    Name="SecondColorPicker"
                                    Width="32"
                                    Height="31"
                                    ColorChanged="SecondColorPicker_ColorChanged"
                                    IsEnabled="{Binding IsColorPickerEnabled}"
                                    Style="{StaticResource DefaultColorPickerStyle}" />
                            </ui:SettingsCard>

                            <!--  Vertical blackbar detection  -->
                            <ui:SettingsCard
                                d:Visibility="Visible"
                                Header="{l:Static resx:Resources.DevicePage_AmbilightVerticalBlackBarDetectionDesc}"
                                Visibility="{Binding Source={x:Reference LEDSettingsLevel}, Path=SelectedIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=6}">
                                <ui:ToggleSwitch Name="Toggle_AmbilightVerticalBlackBarDetection" Toggled="Toggle_AmbilightVerticalBlackBarDetection_Toggled" />
                            </ui:SettingsCard>

                            <!--  OEM Presets  -->
                            <ui:SettingsCard
                                d:Visibility="Visible"
                                Header="{l:Static resx:Resources.DevicePage_DynamicLighting_PresetsSelection}"
                                Visibility="{Binding Source={x:Reference LEDSettingsLevel}, Path=SelectedIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=7}">
                                <ComboBox
                                    Name="LedPresetsComboBox"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    ItemsSource="{Binding DeviceLEDPresets}"
                                    SelectionChanged="LEDOEMPreset_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <ItemContainerTemplate>
                                            <WrapPanel>
                                                <Image
                                                    Width="25"
                                                    Height="25"
                                                    Source="{Binding IconPath}" />
                                                <TextBlock
                                                    Height="25"
                                                    Margin="10,6,0,0"
                                                    Text="{Binding DisplayName}" />
                                            </WrapPanel>
                                        </ItemContainerTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>
                </ikw:SimpleStackPanel>
            </ikw:SimpleStackPanel>

            <!--  Sensor options  -->
            <ikw:SimpleStackPanel Name="SensorOptionsStack" Spacing="8">
                <!--  Sensor Selection  -->
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{l:Static resx:Resources.SettingsPage_SensorOptions}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="Gyroscope and accelerometer selection, calibration and placement" />
                </DockPanel>

                <ikw:SimpleStackPanel Spacing="3">
                    <!--  Sensor selection  -->
                    <ui:SettingsExpander
                        d:IsExpanded="True"
                        Description="{l:Static resx:Resources.SettingsPage_SensorSelectionDesc}"
                        Header="{l:Static resx:Resources.SettingsPage_SensorSelection}">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE950;" />
                        </ui:SettingsExpander.HeaderIcon>

                        <ComboBox
                            Name="cB_SensorSelection"
                            Margin="6,0,0,0"
                            SelectionChanged="cB_SensorSelection_SelectionChanged">
                            <ComboBoxItem
                                Name="SensorNone"
                                Content="{l:Static resx:Resources.SettingsPage_SensorNone}"
                                IsEnabled="True" />
                            <ComboBoxItem
                                Name="SensorInternal"
                                Content="{l:Static resx:Resources.SettingsPage_SensorInternal}"
                                IsEnabled="{Binding IsInternalSensorEnabled}" />
                            <ComboBoxItem
                                Name="SensorExternal"
                                Content="{l:Static resx:Resources.SettingsPage_SensorExternal}"
                                IsEnabled="{Binding IsExternalSensorEnabled}" />
                            <ComboBoxItem
                                Name="SensorController"
                                Content="{l:Static resx:Resources.MainWindow_navController}"
                                IsEnabled="{Binding IsControllerSensorEnabled}" />
                            <ComboBoxItem Name="SensorAuto" Content="Automatic" />
                        </ComboBox>

                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="Calibration mode">
                                <ComboBox Name="cB_SensorCalibrationMode" SelectionChanged="cB_SensorCalibrationMode_SelectionChanged">
                                    <ComboBoxItem Content="Manual" />
                                    <ComboBoxItem Content="Automatic" />
                                </ComboBox>
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="Sensor calibration">
                                <Button
                                    Name="ui_button_calibrate"
                                    Click="ui_button_calibrate_Click"
                                    Content="{l:Static resx:Resources.DevicePage_SensorCalibration_Button}"
                                    IsEnabled="{Binding IsCalibrationEnabled}"
                                    Style="{DynamicResource AccentButtonStyle}" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="Display virtual gamepad">
                                <ToggleButton
                                    Name="ui_toggle_overlayGamepad"
                                    Margin="8,0,0,0"
                                    Command="{Binding ToggleOverlayGamepadCommand}"
                                    Content="Display"
                                    IsChecked="{Binding IsOverlayGamepadVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <controls:AdaptiveColumnPanel
                        BreakWidth="1180"
                        IsEnabled="{Binding IsInternalSensorExpanderEnabled}"
                        Spacing="3"
                        Visibility="{Binding IsInternalSensorExpanderEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!--  Internal|Gyroscope sensor settings  -->
                        <ui:SettingsExpander
                            Name="InternalGyroSensorExpander"
                            d:IsExpanded="True"
                            Description="Adjust the gyroscope axis matrices"
                            Header="Gyroscope">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Glyph="&#xEC4A;" />
                            </ui:SettingsExpander.HeaderIcon>

                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="Axis">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="Invert X"
                                            IsChecked="{Binding GyroAxisX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatAxisToBooleanConverter}}" />

                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="Invert Y"
                                            IsChecked="{Binding GyroAxisY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatAxisToBooleanConverter}}" />

                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="Invert Z"
                                            IsChecked="{Binding GyroAxisZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatAxisToBooleanConverter}}" />
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>

                                <ui:SettingsCard Header="Matrix">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="OrangeRed"
                                                Text="X" />

                                            <ComboBox Margin="6,0,0,0" SelectedIndex="{Binding GyroAxisSwapX, Converter={StaticResource CharToComboBoxIndexConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem>X</ComboBoxItem>
                                                <ComboBoxItem>Y</ComboBoxItem>
                                                <ComboBoxItem>Z</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="YellowGreen"
                                                Text="Y" />

                                            <ComboBox Margin="6,0,0,0" SelectedIndex="{Binding GyroAxisSwapY, Converter={StaticResource CharToComboBoxIndexConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem>X</ComboBoxItem>
                                                <ComboBoxItem>Y</ComboBoxItem>
                                                <ComboBoxItem>Z</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="CornflowerBlue"
                                                Text="Z" />

                                            <ComboBox Margin="6,0,0,0" SelectedIndex="{Binding GyroAxisSwapZ, Converter={StaticResource CharToComboBoxIndexConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem>X</ComboBoxItem>
                                                <ComboBoxItem>Y</ComboBoxItem>
                                                <ComboBoxItem>Z</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!--  Internal|Accelerometer sensor settings  -->
                        <ui:SettingsExpander
                            Name="InternalAcceleroSensorExpander"
                            d:IsExpanded="True"
                            Description="Adjust the accelerometer axis matrices"
                            Header="Accelerometer">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Glyph="&#xEC4A;" />
                            </ui:SettingsExpander.HeaderIcon>

                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="Axis">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="Invert X"
                                            IsChecked="{Binding AcceleroAxisX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatAxisToBooleanConverter}}" />

                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="Invert Y"
                                            IsChecked="{Binding AcceleroAxisY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatAxisToBooleanConverter}}" />

                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="Invert Z"
                                            IsChecked="{Binding AcceleroAxisZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatAxisToBooleanConverter}}" />
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>

                                <ui:SettingsCard Header="Matrix">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="OrangeRed"
                                                Text="X" />

                                            <ComboBox Margin="6,0,0,0" SelectedIndex="{Binding AcceleroAxisSwapX, Converter={StaticResource CharToComboBoxIndexConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem>X</ComboBoxItem>
                                                <ComboBoxItem>Y</ComboBoxItem>
                                                <ComboBoxItem>Z</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="YellowGreen"
                                                Text="Y" />

                                            <ComboBox Margin="6,0,0,0" SelectedIndex="{Binding AcceleroAxisSwapY, Converter={StaticResource CharToComboBoxIndexConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem>X</ComboBoxItem>
                                                <ComboBoxItem>Y</ComboBoxItem>
                                                <ComboBoxItem>Z</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="CornflowerBlue"
                                                Text="Z" />

                                            <ComboBox Margin="6,0,0,0" SelectedIndex="{Binding AcceleroAxisSwapZ, Converter={StaticResource CharToComboBoxIndexConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem>X</ComboBoxItem>
                                                <ComboBoxItem>Y</ComboBoxItem>
                                                <ComboBoxItem>Z</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>
                    </controls:AdaptiveColumnPanel>

                    <!--  External sensor settings  -->
                    <ui:SettingsExpander
                        Name="ExternalSensorExpander"
                        d:IsExpanded="True"
                        Header="External sensor"
                        IsEnabled="{Binding IsExternalSensorExpanderEnabled}">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE950;" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Items>
                            <!--  Sensor Placement Mirror  -->
                            <ui:SettingsCard Description="{l:Static resx:Resources.SettingsPage_SensorPlacementUpsideDownDesc}" Header="{l:Static resx:Resources.SettingsPage_SensorPlacementUpsideDown}">
                                <ui:ToggleSwitch Name="Toggle_SensorPlacementUpsideDown" Toggled="Toggle_SensorPlacementUpsideDown_Toggled" />
                            </ui:SettingsCard>

                            <!--  Sensor Placement Direction  -->
                            <ui:SettingsCard Description="{l:Static resx:Resources.SettingsPage_SensorPlacementDirectionDesc}" Header="{l:Static resx:Resources.SettingsPage_SensorPlacementDirection}">
                                <Grid Name="Grid_SensorPlacementVisualisation">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50" />
                                        <RowDefinition Height="3" />
                                        <RowDefinition Height="50" />
                                        <RowDefinition Height="3" />
                                        <RowDefinition Height="50" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <!--  Top  -->
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="50"
                                        Height="50"
                                        Click="SensorPlacement_Click"
                                        Tag="0" />
                                    <!--  Left  -->
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Width="50"
                                        Height="50"
                                        Click="SensorPlacement_Click"
                                        Tag="1" />
                                    <!--  Right  -->
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="4"
                                        Width="50"
                                        Height="50"
                                        Click="SensorPlacement_Click"
                                        Tag="2" />
                                    <!--  Bottom  -->
                                    <Button
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        Width="50"
                                        Height="50"
                                        Click="SensorPlacement_Click"
                                        Tag="3" />
                                </Grid>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>
                </ikw:SimpleStackPanel>
            </ikw:SimpleStackPanel>

            <!--  Device settings  -->
            <ikw:SimpleStackPanel Spacing="8">
                <TextBlock
                    d:Text="Device settings (MSI Claw)"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{l:Static resx:Resources.DevicePage_DeviceSettings}"
                    Visibility="{Binding ElementName=MSIClawPanel, Path=Visibility}" />

                <!--  Device settings: MSI Claw 8  -->
                <ikw:SimpleStackPanel
                    Name="MSIClawPanel"
                    d:Visibility="Visible"
                    Spacing="3"
                    Visibility="{Binding IsMsiClawVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ui:SettingsCard Description="Select the desired controller mode" Header="Controller mode">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE7FC;" />
                        </ui:SettingsCard.HeaderIcon>

                        <ComboBox SelectedIndex="{Binding ClawControllerIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="Offline" />
                            <ComboBoxItem Content="XInput" />
                            <ComboBoxItem Content="DirectInput" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Description="{l:Static resx:Resources.DevicePage_BlockMsiClawWinGHotkeyDesc}" Header="{l:Static resx:Resources.DevicePage_BlockMsiClawWinGHotkey}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xe765;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:ToggleSwitch IsOn="{Binding BlockMsiClawWinGHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ui:SettingsCard>
                </ikw:SimpleStackPanel>

                <!--  Device settings: Lenovo Legion Go  -->
                <ikw:SimpleStackPanel
                    Name="LegionGoPanel"
                    d:Visibility="Visible"
                    Spacing="3"
                    Visibility="{Binding IsLegionGoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock
                        d:Text="Device settings (Lenovo Legion Go)"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{l:Static resx:Resources.DevicePage_DeviceSettings}"
                        Visibility="{Binding ElementName=LegionGoPanel, Path=Visibility}" />

                    <ui:SettingsCard Description="Select the desired controller mode" Header="Controller mode">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE7FC;" />
                        </ui:SettingsCard.HeaderIcon>

                        <ComboBox SelectedIndex="{Binding LegionControllerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="XInput" />
                            <ComboBoxItem Content="DInput" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <!--
                    <ui:SettingsCard
                        Description="Disables the pad's physical XInput output to cloak it from GameInput and prevent InputRedirection from starving the virtual controller when GameBar, the Xbox app in fullscreen exclusive, or the gamepad-mode virtual keyboard is in the foreground"
                        Header="Experimental: Cloak physical pad from GameInput">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE7FC;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:ToggleSwitch IsOn="{Binding LegionControllerPhysicalXInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ui:SettingsCard>
                    -->

                    <ui:SettingsCard
                        Name="LegionGoPassthrough"
                        Description="{l:Static resx:Resources.ControllerPage_LegionGoPassthroughDesc}"
                        Header="{l:Static resx:Resources.ControllerPage_LegionGoPassthrough}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xe772;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:ToggleSwitch IsOn="{Binding LegionControllerPassthrough, Mode=TwoWay}" />
                    </ui:SettingsCard>

                    <ui:SettingsCard
                        Name="LegionGoControllerSwap"
                        Description="{l:Static resx:Resources.ControllerPage_LegionGoControllerSwapDesc}"
                        Header="{l:Static resx:Resources.ControllerPage_LegionGoControllerSwap}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xe772;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:ToggleSwitch IsOn="{Binding LegionControllerSwap, Mode=TwoWay}" />
                    </ui:SettingsCard>

                    <ui:SettingsCard
                        Name="LegionGoSensorSelection"
                        d:Visibility="Visible"
                        Description="{l:Static resx:Resources.SettingsPage_SensorSelectionDesc}"
                        Header="{l:Static resx:Resources.SettingsPage_SensorSelection}"
                        Visibility="{Binding IsLegionGoSensorSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE950;" />
                        </ui:SettingsCard.HeaderIcon>

                        <ComboBox SelectedIndex="{Binding LegionControllerGyroIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{l:Static resx:Resources.DevicePage_Lenovo_LeftController}" />
                            <ComboBoxItem Content="{l:Static resx:Resources.DevicePage_Lenovo_RightController}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsExpander
                        Name="LegionGoLeftController"
                        d:IsExpanded="True"
                        d:Visibility="Visible"
                        Description="{l:Static resx:Resources.DevicePage_Lenovo_ControllerLeftDesc}"
