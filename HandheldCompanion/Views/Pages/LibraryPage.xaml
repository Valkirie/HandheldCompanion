<Page
    x:Class="HandheldCompanion.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:HandheldCompanion.Behaviors"
    xmlns:controls="clr-namespace:HandheldCompanion.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:l="clr-namespace:HandheldCompanion.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:HandheldCompanion.Properties"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewmodels="clr-namespace:HandheldCompanion.ViewModels"
    Name="Library"
    Title="{l:Static resx:Resources.MainWindow_navLibrary}"
    Margin="0,20,0,0"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodels:LibraryPageViewModel}"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    KeepAlive="True"
    mc:Ignorable="d">

    <StackPanel>
        <TextBlock
            Margin="0,0,0,8"
            behaviors:TextBlockUpperCase.IsUpperCase="True"
            Style="{StaticResource CapitalAccentTextBlockStyle}"
            Text="{Binding Name, RelativeSource={RelativeSource AncestorType=Page}}" />

        <ikw:SimpleStackPanel Spacing="28">
            <DockPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{Binding GameCount, StringFormat={}{0} games}" />
                <TextBlock
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding LastLibraryCheckText}" />
            </DockPanel>

            <StackPanel d:Visibility="Visible" Visibility="{Binding IsScanningLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SettingsCard Description="{Binding ScanPlatformText}" Header="Updating game library">
                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="{Binding ScanProgressText}" />
                </ui:SettingsCard>
                <ui:ProgressBar
                    IsIndeterminate="{Binding IsScanPreparing, Mode=OneWay}"
                    Maximum="{Binding ScanProgressMaximum, Mode=OneWay}"
                    Value="{Binding ScanProgressValue, Mode=OneWay}" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:AutoSuggestBox
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PlaceholderText="Search library..."
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ui:AutoSuggestBox.QueryIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                    </ui:AutoSuggestBox.QueryIcon>
                </ui:AutoSuggestBox>

                <ikw:SimpleStackPanel
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Orientation="Horizontal"
                    Spacing="3">
                    <ComboBox
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        SelectedIndex="{Binding SortTarget}">
                        <ComboBoxItem Content="Alphabetic" />
                        <ComboBoxItem Content="Platform" />
                        <ComboBoxItem Content="Recently added" />
                        <ComboBoxItem Content="Recently played" />
                    </ComboBox>

                    <Button Height="31" Command="{Binding ToggleSortCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <ui:FontIcon
                                            Height="28"
                                            VerticalAlignment="Center"
                                            Icon="{x:Static ui:FluentSystemIcons.ArrowSortDownLines_24_Regular}" />
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <ui:FontIcon
                                                    Height="28"
                                                    VerticalAlignment="Center"
                                                    Icon="{x:Static ui:FluentSystemIcons.ArrowSortUpLines_24_Regular}" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Height="31" Command="{Binding ToggleViewModeCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <ui:FontIcon
                                            Height="28"
                                            VerticalAlignment="Center"
                                            Icon="{x:Static ui:FluentSystemIcons.AppsListDetail_24_Filled}" />
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="1">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <ui:FontIcon
                                                    Height="28"
                                                    VerticalAlignment="Center"
                                                    Icon="{x:Static ui:FluentSystemIcons.Grid_20_Filled}" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="2">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <ui:FontIcon
                                                    Height="28"
                                                    VerticalAlignment="Center"
                                                    Icon="{x:Static ui:FluentSystemIcons.GridKanban_20_Filled}" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ui:DropDownButton HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <ui:DropDownButton.Content>
                            <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xe712;" />
                        </ui:DropDownButton.Content>

                        <ui:DropDownButton.Flyout>
                            <ui:MenuFlyout Placement="Bottom">
                                <MenuItem
                                    Command="{Binding RefreshMetadataCommand}"
                                    Header="Download metadata and artworks"
                                    IsEnabled="{Binding IsLibraryConnected, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Separator />
                                <MenuItem Header="Update game library" IsEnabled="{Binding IsScanningLibrary, Converter={StaticResource InvertBooleanConverter}}">
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="All"
                                        Header="All" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="BattleNet"
                                        Header="Battle.net" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="Epic"
                                        Header="Epic" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="GOG"
                                        Header="GOG GALAXY" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="Origin"
                                        Header="Origin" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="EA Desktop"
                                        Header="EA Desktop" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="Riot"
                                        Header="Riot Games" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="Rockstar"
                                        Header="Rockstar" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="Steam"
                                        Header="Steam" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="Microsoft Store"
                                        Header="Microsoft Store" />
                                    <MenuItem
                                        Command="{Binding ScanLibraryCommand}"
                                        CommandParameter="Ubisoft"
                                        Header="Ubisoft Connect" />
                                    <Separator />
                                    <MenuItem Header="Consoles">
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Emulators"
                                            Header="All" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:GameCube"
                                            Header="GameCube" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Wii"
                                            Header="Wii" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Wii U"
                                            Header="Wii U" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:PlayStation"
                                            Header="PlayStation" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:PlayStation 2"
                                            Header="PlayStation 2" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:PlayStation 3"
                                            Header="PlayStation 3" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:PlayStation 4"
                                            Header="PlayStation 4" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:PlayStation Portable"
                                            Header="PlayStation Portable" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:PlayStation Vita"
                                            Header="PlayStation Vita" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Nintendo 3DS"
                                            Header="Nintendo 3DS" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Nintendo Switch"
                                            Header="Nintendo Switch" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Nintendo 64"
                                            Header="Nintendo 64" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Nintendo DS"
                                            Header="Nintendo DS" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Arcade"
                                            Header="Arcade" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Multi-system"
                                            Header="Multi-system" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Game Boy"
                                            Header="Game Boy" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Game Boy Color"
                                            Header="Game Boy Color" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Game Boy Advance"
                                            Header="Game Boy Advance" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Super Nintendo"
                                            Header="Super Nintendo" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Xbox"
                                            Header="Xbox" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Xbox 360"
                                            Header="Xbox 360" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Dreamcast"
                                            Header="Dreamcast" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Naomi"
                                            Header="Naomi" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:Atomiswave"
                                            Header="Atomiswave" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:PC Adventure"
                                            Header="PC Adventure" />
                                        <MenuItem
                                            Command="{Binding ScanLibraryCommand}"
                                            CommandParameter="Console:DOS"
                                            Header="DOS" />
                                    </MenuItem>
                                </MenuItem>
                            </ui:MenuFlyout>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </ikw:SimpleStackPanel>
            </Grid>

            <controls:AdaptiveNavigationView
                x:Name="navView"
                IsBackButtonVisible="Collapsed"
                IsBackEnabled="False"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTabStop="False"
                ItemInvoked="navView_ItemInvoked"
                Loaded="navView_Loaded"
                MenuItemsSource="{Binding NavigationItems}"
                OpenPaneLength="220"
                PaneDisplayMode="Top"
                SelectedItem="{Binding NavigationViewSelectedItem, Mode=OneWay}"
                SelectionFollowsFocus="Enabled"
                ShoulderNavigationEnabled="WhenSelectionFollowsFocus"
                TopNavItemsAlignment="Center">

                <controls:AdaptiveNavigationView.Resources>
                    <StaticResource x:Key="TopNavigationViewItemBackgroundPointerOver" ResourceKey="NavigationViewItemBackgroundPointerOver" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundPressed" ResourceKey="NavigationViewItemBackgroundPressed" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelected" ResourceKey="NavigationViewItemBackgroundSelected" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" ResourceKey="NavigationViewItemBackgroundSelectedPointerOver" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPressed" ResourceKey="NavigationViewItemBackgroundSelectedPressed" />
                    <StaticResource x:Key="TopNavigationViewItemForegroundPointerOver" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                    <StaticResource x:Key="TopNavigationViewItemForegroundPressed" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                    <StaticResource x:Key="TopNavigationViewItemForegroundSelected" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                    <StaticResource x:Key="TopNavigationViewItemForegroundSelectedPointerOver" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                    <StaticResource x:Key="TopNavigationViewItemForegroundSelectedPressed" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                </controls:AdaptiveNavigationView.Resources>

                <controls:AdaptiveNavigationView.MenuItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}" TargetType="ui:NavigationViewItem">
                        <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackground}" />
                        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
                        <Setter Property="Content" Value="{Binding Title}" />
                        <Setter Property="Tag" Value="{Binding Key}" />
                        <Setter Property="IsTabStop" Value="True" />
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Setter Property="Icon" Value="{Binding Icon}" />
                        <Setter Property="InfoBadge" Value="{Binding InfoBadge}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                <Setter Property="Icon" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:AdaptiveNavigationView.MenuItemContainerStyle>

                <ui:Frame
                    Name="ContentFrame"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type FrameworkElement}}}"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Navigated="ContentFrame_Navigated" />
            </controls:AdaptiveNavigationView>
        </ikw:SimpleStackPanel>
    </StackPanel>
</Page>