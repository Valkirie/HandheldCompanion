<common:GamepadWindow
    x:Class="HandheldCompanion.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:HandheldCompanion.Behaviors"
    xmlns:common="clr-namespace:HandheldCompanion.Views.Classes"
    xmlns:controls="clr-namespace:HandheldCompanion.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:l="clr-namespace:HandheldCompanion.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:HandheldCompanion.Properties"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewmodels="clr-namespace:HandheldCompanion.ViewModels"
    Title="{l:Static resx:Resources.MainWindow_HandheldCompanion}"
    Width="1280"
    Height="720"
    MinWidth="640"
    MinHeight="480"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
    d:Visibility="Visible"
    ui:ThemeManager.IsThemeAware="True"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:TitleBar.Height="48"
    ui:WindowHelper.ApplyNoise="{Binding MainWindowApplyNoise, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:WindowHelper.UseModernWindowStyle="True"
    Closed="Window_Closed"
    Closing="Window_Closing"
    Icon="/Resources/icon.png"
    Loaded="Window_Loaded"
    PreviewLostKeyboardFocus="GamepadWindow_PreviewLostKeyboardFocus"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Minimized"
    mc:Ignorable="d">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarItem" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <ui:InfoBar
            Title="{Binding InfoBarTitle}"
            Margin="0,0,24,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Panel.ZIndex="999"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CloseButtonCommand="{Binding DismissInfoBarCommand}"
            IsClosable="True"
            IsOpen="{Binding IsInfoBarOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Message="{Binding InfoBarMessage}"
            Severity="{Binding InfoBarSeverity}">

            <ui:InfoBar.Effect>
                <DropShadowEffect
                    BlurRadius="16"
                    Direction="270"
                    Opacity="0.5"
                    ShadowDepth="2" />
            </ui:InfoBar.Effect>

            <ui:InfoBar.RenderTransform>
                <TranslateTransform Y="60" />
            </ui:InfoBar.RenderTransform>

            <ui:InfoBar.Style>
                <Style TargetType="ui:InfoBar">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="60" />
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInfoBarOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="ShowStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            To="0"
                                            Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Name="HideStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            To="60"
                                            Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:InfoBar.Style>
        </ui:InfoBar>

        <ui:ProgressRing
            Width="60"
            Height="60"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="1000"
            IsActive="{Binding IsInitializing, UpdateSourceTrigger=PropertyChanged}"
            IsIndeterminate="{Binding IsInitializing, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding IsInitializing, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ui:ContentDialog Name="ContentDialog" />
        <ui:ContentDialog x:Name="LaunchProfileDialog" Title="">
            <ui:ContentDialog.Resources>
                <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="Transparent" />
                <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
                <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ContentDialogLightDismissOverlayBackground" Color="Transparent" />
                <Thickness x:Key="ContentDialogPadding">0</Thickness>
                <Thickness x:Key="ContentDialogContentMargin">0</Thickness>
                <Thickness x:Key="ContentDialogContentScrollViewerMargin">0</Thickness>
                <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
                <Thickness x:Key="ContentDialogCommandSpaceMargin">0</Thickness>
                <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
            </ui:ContentDialog.Resources>

            <Border
                Width="540"
                Height="270"
                Background="{Binding LaunchProfileDialog.BackgroundBrush}"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image
                        Height="110"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding LaunchProfileDialog.Logo}"
                        Stretch="Uniform"
                        Visibility="{Binding LaunchProfileDialog.HasLogo, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Border
                        Grid.Row="1"
                        Padding="16,12"
                        Background="#FF3A3A3A"
                        CornerRadius="0,0,12,12">
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{Binding LaunchProfileDialog.ProfileName}"
                                TextAlignment="Left"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{Binding LaunchProfileDialog.ProfileDescription}"
                                TextAlignment="Left"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </ui:ContentDialog>

        <controls:AdaptiveNavigationView
            x:Name="navView"
            BackRequested="navView_BackRequested"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="{Binding ElementName=ContentFrame, Path=CanGoBack, Mode=OneWay}"
            IsSettingsVisible="False"
            ItemInvoked="navView_ItemInvoked"
            Loaded="navView_Loaded"
            PaneDisplayMode="Top"
            SelectionFollowsFocus="Enabled"
            TopNavItemsAlignment="Left">

            <controls:AdaptiveNavigationView.Resources>
                <StaticResource x:Key="TopNavigationViewItemBackgroundPointerOver" ResourceKey="NavigationViewItemBackgroundPointerOver" />
                <StaticResource x:Key="TopNavigationViewItemBackgroundPressed" ResourceKey="NavigationViewItemBackgroundPressed" />
                <StaticResource x:Key="TopNavigationViewItemBackgroundSelected" ResourceKey="NavigationViewItemBackgroundSelected" />
                <StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" ResourceKey="NavigationViewItemBackgroundSelectedPointerOver" />
                <StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPressed" ResourceKey="NavigationViewItemBackgroundSelectedPressed" />
                <StaticResource x:Key="TopNavigationViewItemForegroundPointerOver" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                <StaticResource x:Key="TopNavigationViewItemForegroundPressed" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                <StaticResource x:Key="TopNavigationViewItemForegroundSelected" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                <StaticResource x:Key="TopNavigationViewItemForegroundSelectedPointerOver" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                <StaticResource x:Key="TopNavigationViewItemForegroundSelectedPressed" ResourceKey="NavigationViewSelectionIndicatorForeground" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </controls:AdaptiveNavigationView.Resources>

            <controls:AdaptiveNavigationView.MenuItemContainerStyle>
                <Style TargetType="ui:NavigationViewItem">
                    <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackground}" />
                    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
                    <Setter Property="IsTabStop" Value="True" />
                </Style>
            </controls:AdaptiveNavigationView.MenuItemContainerStyle>

            <ui:NavigationView.HeaderTemplate>
                <DataTemplate />
                <!--  Empty  -->
            </ui:NavigationView.HeaderTemplate>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem IsEnabled="False">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon
                            Name="GamepadUILB"
                            Margin="-6,0,-6,0"
                            FontFamily="PromptFont"
                            FontSize="22"
                            Glyph="&#x2198;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  Game icon  -->
                <ui:NavigationViewItem
                    Name="navController"
                    Content="{l:Static resx:Resources.MainWindow_navController}"
                    Tag="ControllerPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Game}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  Game icon  -->
                <ui:NavigationViewItem
                    Name="navLibrary"
                    Content="{l:Static resx:Resources.MainWindow_navLibrary}"
                    Tag="LibraryPage"
                    Visibility="{Binding IsNavLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Library}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  Device icon  -->
                <ui:NavigationViewItem
                    Name="navDevice"
                    Content="{l:Static resx:Resources.MainWindow_navDevice}"
                    Tag="DevicePage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.XboxOneConsole}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  Performance icon  -->
                <ui:NavigationViewItem
                    Name="navPerformance"
                    Content="{l:Static resx:Resources.MainWindow_navPerformance}"
                    IsEnabled="{Binding IsNavPerformanceEnabled}"
                    Tag="PerformancePage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.SpeedHigh}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  Profiles icon  -->
                <ui:NavigationViewItem
                    Name="navProfiles"
                    Content="{l:Static resx:Resources.MainWindow_navProfiles}"
                    Tag="ProfilesPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.SwitchUser}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  Overlay icon  -->
                <ui:NavigationViewItem
                    Name="navOverlay"
                    Content="{l:Static resx:Resources.MainWindow_navOverlay}"
                    Tag="OverlayPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ShareScreenPersonOverlayInside_16_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  Hotkeys icon  -->
                <ui:NavigationViewItem
                    Name="navHotkeys"
                    Content="{l:Static resx:Resources.MainWindow_navHotkeys}"
                    Tag="HotkeysPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardShortcut}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem IsEnabled="False">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon
                            Name="GamepadUIRB"
                            Margin="-6,0,0,0"
                            FontFamily="PromptFont"
                            FontSize="22"
                            Glyph="&#x2199;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <!--  Notifications icon  -->
                <ui:NavigationViewItem Name="navNotifications" Tag="NotificationsPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xea8f;" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge
                            Name="HasNotifications"
                            d:Visibility="Visible"
                            Visibility="Collapsed" />
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>

                <!--  Settings  -->
                <ui:NavigationViewItem Name="navSettings" Tag="SettingsPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Settings}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  About icon  -->
                <ui:NavigationViewItem Name="navAbout" Tag="AboutPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.Content>
                <ui:ScrollViewerEx
                    x:Name="scrollViewer"
                    Margin="0,-60,0,0"
                    PanningMode="VerticalFirst">
                    <ui:Frame
                        Name="ContentFrame"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type FrameworkElement}}}"
                        MaxWidth="1900"
                        HorizontalAlignment="Center" />
                </ui:ScrollViewerEx>
            </ui:NavigationView.Content>
        </controls:AdaptiveNavigationView>

        <Border
            Grid.Row="1"
            Background="{DynamicResource NavigationViewContentBackground}"
            BorderBrush="{DynamicResource NavigationViewContentGridBorderBrush}"
            BorderThickness="{DynamicResource NavigationViewContentGridBorderThickness}">
            <Grid Margin="24,0">
                <ikw:SimpleStackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--  Select  -->
                    <Button
                        Name="GamepadUISelect"
                        Height="42"
                        d:Visibility="Visible"
                        Click="GamepadUISelect_Click"
                        Focusable="False"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <ui:FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{DynamicResource NavigationViewDefaultPaneBackground}"
                                    Glyph="&#xe91f;" />
                                <ui:FontIcon
                                    Name="GamepadUISelectIcon"
                                    VerticalAlignment="Center"
                                    FontFamily="PromptFont"
                                    FontSize="28"
                                    Glyph="&#x21D3;" />
                            </Grid>
                            <TextBlock
                                Name="GamepadUISelectDesc"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{l:Static resx:Resources.MainWindow_Select}" />
                        </StackPanel>
                    </Button>

                    <!--  Back  -->
                    <Button
                        Name="GamepadUIBack"
                        Height="42"
                        d:Visibility="Visible"
                        Click="GamepadUIBack_Click"
                        Focusable="False"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <ui:FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{DynamicResource NavigationViewDefaultPaneBackground}"
                                    Glyph="&#xe91f;" />
                                <ui:FontIcon
                                    Name="GamepadUIBackIcon"
                                    VerticalAlignment="Center"
                                    FontFamily="PromptFont"
                                    FontSize="28"
                                    Glyph="&#x21D2;" />
                            </Grid>
                            <TextBlock
                                Name="GamepadUIBackDesc"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{l:Static resx:Resources.MainWindow_Back}" />
                        </StackPanel>
                    </Button>

                    <!--  Toggle  -->
                    <Button
                        Name="GamepadUIToggle"
                        Height="42"
                        d:Visibility="Visible"
                        Click="GamepadUIToggle_Click"
                        Focusable="False"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <ui:FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{DynamicResource NavigationViewDefaultPaneBackground}"
                                    Glyph="&#xe91f;" />
                                <ui:FontIcon
                                    Name="GamepadUIToggleIcon"
                                    VerticalAlignment="Center"
                                    FontFamily="PromptFont"
                                    FontSize="28" />
                            </Grid>
                            <TextBlock
                                Name="GamepadUIToggleDesc"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Style="{StaticResource BaseTextBlockStyle}" />
                        </StackPanel>
                    </Button>

                    <!--  More (X button for Open Layout)  -->
                    <Button
                        Name="GamepadUIMore"
                        Height="42"
                        d:Visibility="Visible"
                        Click="GamepadUIMore_Click"
                        Focusable="False"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <ui:FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{DynamicResource NavigationViewDefaultPaneBackground}"
                                    Glyph="&#xe91f;" />
                                <ui:FontIcon
                                    Name="GamepadUIMoreIcon"
                                    VerticalAlignment="Center"
                                    FontFamily="PromptFont"
                                    FontSize="28" />
                            </Grid>
                            <TextBlock
                                Name="GamepadUIMoreDesc"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Style="{StaticResource BaseTextBlockStyle}" />
                        </StackPanel>
                    </Button>

                    <!--  Like (Back button for Toggle Like)  -->
                    <Button
                        Name="GamepadUILike"
                        Height="42"
                        d:Visibility="Visible"
                        Click="GamepadUILike_Click"
                        Focusable="False"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <ui:FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{DynamicResource NavigationViewDefaultPaneBackground}"
                                    Glyph="&#xe91f;" />
                                <ui:FontIcon
                                    Name="GamepadUILikeIcon"
                                    VerticalAlignment="Center"
                                    FontFamily="PromptFont"
                                    FontSize="28" />
                            </Grid>
                            <TextBlock
                                Name="GamepadUILikeDesc"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Style="{StaticResource BaseTextBlockStyle}" />
                        </StackPanel>
                    </Button>
                </ikw:SimpleStackPanel>
            </Grid>
        </Border>
    </Grid>
</common:GamepadWindow>